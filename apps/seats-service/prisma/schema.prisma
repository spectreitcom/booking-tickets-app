// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Event {
  id    String @id @default(uuid(4)) @db.Uuid
  name  String @db.VarChar(120)
  seats Seat[]

  @@index([name])
  @@map("events")
}

model Seat {
  id                  String     @id @default(uuid(4)) @db.Uuid
  price               Int        @default(0)
  status              SeatStatus @default(AVAILABLE)
  reservedByBookingId String?    @db.Uuid

  eventId String @db.Uuid
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, status])
  @@map("seats")
}

enum SeatStatus {
  AVAILABLE
  RESERVED
}

// Outbox

model OutboxMessage {
  id            String       @id @default(uuid(4)) @db.Uuid
  messageType   String       @db.VarChar(255)
  exchange      String       @db.VarChar(60)
  routingKey    String       @db.VarChar(255)
  payload       Json         @db.JsonB
  headers       Json         @default("{}") @db.JsonB
  correlationId String?      @db.Uuid
  causationId   String?      @db.Uuid
  sagaId        String?      @db.Uuid
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  availableAt   DateTime     @default(now())
  lockedAt      DateTime?
  lockToken     String?      @db.Uuid
  createdAt     DateTime     @default(now())

  @@index([status, availableAt, createdAt])
  @@index([status, availableAt, lockedAt])
  @@index([correlationId])
  @@index([sagaId])
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}
